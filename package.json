{
	"name": "chess-lens",
	"version": "1.0.2",
	"type": "commonjs",
	"description": "Chess Lens - real-time chess analysis and live move coaching",
	"author": {
		"name": "VideoDB",
		"email": "support@videodb.io",
		"url": "https://videodb.io"
	},
	"license": "MIT",
	"main": "dist/main/index.js",
	"scripts": {
		"dev": "npm run build:main && concurrently -k \"npm run dev:renderer\" \"node scripts/delay-electron.js\"",
		"dev:renderer": "vite",
		"build": "npm run build:renderer && npm run build:main",
		"build:main": "tsc -p tsconfig.node.json",
		"build:renderer": "vite build",
		"preview": "vite preview",
		"start": "electron .",
		"rebuild": "electron-rebuild -f -w better-sqlite3",
		"postinstall": "electron-rebuild -f -w better-sqlite3 || true",
		"dist": "npm run build && electron-builder",
		"dist:mac": "npm run build && electron-builder --mac",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
		"lint": "eslint src --ext .ts,.tsx",
		"test:node": "vitest run --config vitest.node.config.ts",
		"smoke:frames": "tsx tools/validation/validate_project_frames.ts",
		"smoke:postgame": "tsx tools/validation/validate_postgame_fixture.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"tools:check-export": "ts-node ./tools/maintenance/checkSessionExport.ts",
		"tools:recover-session": "ts-node ./tools/maintenance/recoverSession.ts",
		"tools:check-model": "tsx ./tools/diagnostics/checkModelAvailability.ts",
		"tools:simulate-pipeline-latency": "tsx ./tools/diagnostics/simulatePipelineLatency.ts",
		"tools:analyze-latency": "tsx ./tools/diagnostics/analyzeLatencyLogs.ts"
	},
	"dependencies": {
		"@hono/node-server": "^1.14.1",
		"@hono/trpc-server": "^0.3.4",
		"@modelcontextprotocol/sdk": "^1.0.0",
		"@tanstack/react-query": "^5.75.5",
		"@trpc/client": "^11.1.2",
		"@trpc/react-query": "^11.1.2",
		"@trpc/server": "^11.1.2",
		"@videodb/recorder": "^0.2.4",
		"better-sqlite3": "^12.6.2",
		"drizzle-orm": "^0.45.2",
		"fix-path": "^5.0.0",
		"hono": "^4.7.5",
		"onnxruntime-node": "^1.26.0",
		"openai": "^6.19.0",
		"pino": "^9.6.0",
		"pino-pretty": "^13.0.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-markdown": "^10.1.0",
		"sharp": "^0.34.5",
		"stockfish": "^18.0.7",
		"uuid": "^11.1.0",
		"videodb": "^0.2.4",
		"zod": "^3.25.4",
		"zustand": "^5.0.4"
	},
	"devDependencies": {
		"@electron/rebuild": "^4.2.0",
		"@eslint/js": "^10.0.1",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^22.15.16",
		"@types/react": "^19.1.4",
		"@types/react-dom": "^19.1.3",
		"@types/uuid": "^10.0.0",
		"@vitejs/plugin-react": "^4.4.1",
		"autoprefixer": "^10.4.21",
		"chess.js": "^1.4.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"concurrently": "^9.1.2",
		"drizzle-kit": "^0.31.0",
		"electron": "^39.0.0",
		"electron-builder": "^26.15.3",
		"eslint": "^10.6.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.7.0",
		"lucide-react": "^0.510.0",
		"png-to-ico": "^3.0.1",
		"postcss": "^8.5.3",
		"tailwind-merge": "^3.2.0",
		"tailwindcss": "^3.4.17",
		"tailwindcss-animate": "^1.0.7",
		"tsx": "^4.23.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.63.0",
		"vite": "^6.3.5",
		"vitest": "^4.1.10"
	},
	"build": {
		"extends": "./electron-builder.config.js"
	},
	"overrides": {
		"videodb": {
			"uuid": "^11.1.1"
		}
	}
}
